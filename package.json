{
  "name": "aura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3300",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3300",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
