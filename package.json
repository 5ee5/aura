{
  "name": "aura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3301",
    "build": "next build",
    "deploy": "NEXT_DIST_DIR=.next-prod next build && pm2 startOrRestart ecosystem.config.cjs --only aura",
    "start": "next start -H 127.0.0.1 -p 3300",
    "set-password": "node scripts/set-password.ts",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "test:e2e": "scripts/e2e.sh"
  },
  "dependencies": {
    "lucide-react": "^1.82.0",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
