# Public base URL of the app. Used for cookie security, calendar links and OAuth redirects.
APP_URL=http://localhost:3300

# debug | info | warn | error
LOG_LEVEL=info

# Both are written by: npm run set-password
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# PostgreSQL. A second database named aura_test, same user, is used by tests.
DATABASE_URL=postgresql://aura:password@127.0.0.1:5432/aura

# Where daily database dumps go: a folder with mode 700, ideally on another drive.
BACKUP_DIR=
# Optional: that drive's mount point. Backups fail if nothing is mounted there.
BACKUP_MOUNT=

# From console.anthropic.com. Empty means the coach is a labelled mock.
ANTHROPIC_API_KEY=
# Most the app will spend on Claude in any 24 hours, in US dollars.
COACH_DAILY_BUDGET_USD=2
# Garmin Connect, Settings, Personal API Key. Empty turns Garmin sync off.
GARMIN_API_KEY=
# 0 stops the live app syncing Garmin every 2 hours; the buttons still work.
GARMIN_AUTO_SYNC=

NEXT_TELEMETRY_DISABLED=1
